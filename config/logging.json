{
  "version": 1,
  "disable_existing_loggers": false,
  "filters": {
    "redact_request_content": {"()": "vllm_privacy.filters.RedactRequestContent"}
  },
  "formatters": {
    "json": {
      "()": "pythonjsonlogger.json.JsonFormatter",
      "fmt": "%(asctime)s %(levelname)s %(name)s %(vllm_process_name)s %(message)s",
      "rename_fields": {"asctime": "time", "levelname": "level", "name": "logger", "vllm_process_name": "process"},
      "datefmt": "%Y-%m-%dT%H:%M:%S%z"
    }
  },
  "handlers": {
    "stdout": {
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stdout",
      "formatter": "json",
      "filters": ["redact_request_content"]
    }
  },
  "loggers": {
    "vllm": {"handlers": ["stdout"], "level": "INFO", "propagate": false},
    "vllm_privacy": {"handlers": ["stdout"], "level": "INFO", "propagate": false},
    "uvicorn": {"handlers": ["stdout"], "level": "INFO", "propagate": false},
    "uvicorn.access": {"handlers": [], "level": "WARNING", "propagate": false}
  },
  "root": {"handlers": ["stdout"], "level": "WARNING"}
}
